@model Quotation
@{
    ViewData["Title"] = "Edit Quotation";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-6 fw-bold text-gradient mb-2">
                    <i class="fas fa-edit me-3"></i>Edit Quotation
                </h1>
                <p class="lead text-muted mb-0">
                    Quotation Number: <strong>@Model.QuotationNumber</strong>
                    <span class="badge status-@Model.Status.ToString().ToLower() ms-2">@Model.Status</span>
                </p>
            </div>
            <div class="d-none d-md-block">
                <div class="btn-group">
                    <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-outline-info">
                        <i class="fas fa-eye me-2"></i>View Details
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Form -->
<form asp-action="Edit" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="QuotationNumber" type="hidden" />
    <input asp-for="CreatedDate" type="hidden" />
    
    <!-- Customer & Project Information -->
    <div class="row mb-4">
        <!-- Customer Information (Read-only) -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-soft h-100">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user me-2"></i>Customer Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="customer-info-card">
                        <div class="row">
                            <div class="col-12">
                                <h6 class="fw-bold text-primary mb-2">@Model.Customer?.CompanyName</h6>
                                <p class="mb-1">@Model.Customer?.Name</p>
                                <p class="mb-1">@Model.Customer?.Email • @Model.Customer?.Phone</p>
                                <p class="mb-1">@Model.Customer?.Address, @Model.Customer?.City @Model.Customer?.PostalCode</p>
                                @if (!string.IsNullOrEmpty(Model.Customer?.GstNumber))
                                {
                                    <p class="mb-0 text-muted">GST: @Model.Customer.GstNumber</p>
                                }
                            </div>
                        </div>
                    </div>
                    <input asp-for="CustomerId" type="hidden" />
                </div>
            </div>
        </div>

        <!-- Project Details -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-soft h-100">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-project-diagram me-2"></i>Project Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="ProjectName" class="form-label fw-semibold">
                            <i class="fas fa-tag me-1"></i>Project Name
                        </label>
                        <input asp-for="ProjectName" class="form-control" placeholder="Enter project name">
                        <span asp-validation-for="ProjectName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">
                            <i class="fas fa-align-left me-1"></i>Description
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the work"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="QuotationDate" class="form-label fw-semibold">
                                <i class="fas fa-calendar me-1"></i>Quotation Date *
                            </label>
                            <input asp-for="QuotationDate" type="date" class="form-control" required>
                            <span asp-validation-for="QuotationDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ValidUntil" class="form-label fw-semibold">
                                <i class="fas fa-clock me-1"></i>Valid Until *
                            </label>
                            <input asp-for="ValidUntil" type="date" class="form-control" required>
                            <span asp-validation-for="ValidUntil" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status & Tax Settings -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-flag me-2 text-primary"></i>Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">
                            <i class="fas fa-tasks me-1"></i>Quotation Status
                        </label>
                        <select asp-for="Status" class="form-select">
                            @foreach (QuotationStatus status in Enum.GetValues<QuotationStatus>())
                            {
                                <option value="@status" selected="@(Model.Status == status)">@status</option>
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calculator me-2 text-primary"></i>Tax Configuration
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TaxRate" class="form-label fw-semibold">
                                <i class="fas fa-percentage me-1"></i>Tax Rate (%)
                            </label>
                            <input asp-for="TaxRate" type="number" step="0.01" min="0" max="100" class="form-control">
                            <span asp-validation-for="TaxRate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch mt-4">
                                <input asp-for="IsTaxInclusive" class="form-check-input" type="checkbox">
                                <label class="form-check-label fw-semibold" asp-for="IsTaxInclusive">
                                    <i class="fas fa-toggle-on me-1"></i>Tax Inclusive
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Terms and Totals -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-contract me-2 text-primary"></i>Terms and Conditions
                    </h5>
                </div>
                <div class="card-body">
                    <textarea asp-for="TermsAndConditions" class="form-control" rows="6" placeholder="Enter terms and conditions"></textarea>
                    <span asp-validation-for="TermsAndConditions" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 mb-4">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calculator me-2"></i>Current Totals
                    </h5>
                </div>
                <div class="card-body">
                    <div class="quotation-totals">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span class="fw-bold">₹@Model.SubTotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (@Model.TaxRate%):</span>
                            <span class="fw-bold">₹@Model.TaxAmount.ToString("N2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <span class="h5 fw-bold">Total:</span>
                            <span class="h5 fw-bold text-success">₹@Model.TotalAmount.ToString("N2")</span>
                        </div>
                    </div>
                    
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Line items can be managed separately
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-soft">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Last updated: @Model.UpdatedDate?.ToString("MMM dd, yyyy HH:mm") 
                            </small>
                        </div>
                        <div class="btn-group">
                            <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Update Quotation
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
/* Edit-specific styles */
.customer-info-card {
    background: linear-gradient(135deg, var(--light-color) 0%, #f1f5f9 100%);
    border-radius: var(--border-radius);
    padding: 1rem;
    border: 1px solid var(--border-color);
}

.quotation-totals {
    background: var(--light-color);
    border-radius: var(--border-radius);
    padding: 1rem;
}

.btn-group .btn {
    min-width: 120px;
}

@@media (max-width: 768px) {
    .btn-group {
        flex-direction: column;
        width: 100%;
    }
    
    .btn-group .btn {
        margin-bottom: 0.5rem;
    }
}
</style>
