@model Quotation
@{
    ViewData["Title"] = "Create Quotation";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-6 fw-bold text-gradient mb-2">
                    <i class="fas fa-plus-circle me-3"></i>Create New Quotation
                </h1>
                <p class="lead text-muted mb-0">Generate professional quotations for your customers</p>
            </div>
            <div class="d-none d-md-block">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Quotations
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="quotation-loading" class="loading-overlay d-none">
    <div class="loading-spinner"></div>
</div>

<!-- Main Form -->
<form id="quotation-form" asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id, new { id = "quotation-id" })
    
    <!-- Customer & Project Information -->
    <div class="row mb-4">
        <!-- Customer Selection -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-soft h-100">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user me-2"></i>Customer Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label asp-for="CustomerId" class="form-label fw-semibold mb-0">
                                <i class="fas fa-users me-1"></i>Select Customer *
                            </label>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="create-customer-btn">
                                <i class="fas fa-plus me-1"></i>New Customer
                            </button>
                        </div>
                        <select asp-for="CustomerId" class="form-select" id="customer-select" required>
                            <option value="">-- Select Customer --</option>
                            @foreach (var customer in (ViewBag.CustomerId as SelectList) ?? new SelectList(new List<object>()))
                            {
                                <option value="@customer.Value">@customer.Text</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                    
                    <!-- Customer Details Display -->
                    <div id="customer-details" class="d-none">
                        <div class="customer-info-card">
                            <div class="row">
                                <div class="col-12">
                                    <h6 class="fw-bold text-primary mb-2" id="customer-company"></h6>
                                    <p class="mb-1" id="customer-contact"></p>
                                    <p class="mb-1" id="customer-address"></p>
                                    <p class="mb-0 text-muted" id="customer-gst"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Project Details -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-soft h-100">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-project-diagram me-2"></i>Project Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="ProjectName" class="form-label fw-semibold">
                            <i class="fas fa-tag me-1"></i>Project Name
                        </label>
                        <input asp-for="ProjectName" class="form-control" placeholder="Enter project name">
                        <span asp-validation-for="ProjectName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">
                            <i class="fas fa-align-left me-1"></i>Description
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the work"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="QuotationDate" class="form-label fw-semibold">
                                <i class="fas fa-calendar me-1"></i>Quotation Date *
                            </label>
                            <input asp-for="QuotationDate" type="date" class="form-control" required>
                            <span asp-validation-for="QuotationDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ValidUntil" class="form-label fw-semibold">
                                <i class="fas fa-clock me-1"></i>Valid Until *
                            </label>
                            <input asp-for="ValidUntil" type="date" class="form-control" required>
                            <span asp-validation-for="ValidUntil" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tax Settings -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calculator me-2 text-primary"></i>Tax Configuration
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3">
                            <label asp-for="TaxRate" class="form-label fw-semibold">
                                <i class="fas fa-percentage me-1"></i>Tax Rate (%)
                            </label>
                            <input asp-for="TaxRate" type="number" step="0.01" min="0" max="100" class="form-control" id="tax-rate">
                            <span asp-validation-for="TaxRate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check form-switch mt-4">
                                <input asp-for="IsTaxInclusive" class="form-check-input" type="checkbox" id="tax-inclusive">
                                <label class="form-check-label fw-semibold" for="tax-inclusive">
                                    <i class="fas fa-toggle-on me-1"></i>Tax Inclusive Pricing
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="tax-info-display">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span id="tax-info-text">Tax will be calculated on line totals</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Line Items Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-list me-2"></i>Line Items
                        </h5>
                        <div class="btn-group no-print" role="group">
                            <button type="button" class="btn btn-light btn-sm" id="add-line-item">
                                <i class="fas fa-box me-1"></i>Add Product
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm" id="add-custom-item">
                                <i class="fas fa-edit me-1"></i>Add Custom Item
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="line-items-table">
                            <thead class="table-light">
                                <tr>
                                    <th width="5%">#</th>
                                    <th width="5%">Type</th>
                                    <th width="22%">Product/Item</th>
                                    <th width="15%">Description</th>
                                    <th width="8%">Qty</th>
                                    <th width="8%">Unit</th>
                                    <th width="12%">Unit Price</th>
                                    <th width="12%">Line Total</th>
                                    <th width="8%" class="no-print">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="line-items-body">
                                <!-- Line items will be added here dynamically -->
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Empty State -->
                    <div id="empty-line-items" class="text-center py-5">
                        <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No items added yet</h5>
                        <p class="text-muted mb-3">Add products from catalog or create custom items</p>
                        <div class="btn-group no-print" role="group">
                            <button type="button" class="btn btn-primary" id="add-first-item">
                                <i class="fas fa-box me-2"></i>Add Product
                            </button>
                            <button type="button" class="btn btn-outline-primary" id="add-first-custom-item">
                                <i class="fas fa-edit me-2"></i>Add Custom Item
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Totals Summary -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-contract me-2 text-primary"></i>Terms and Conditions
                    </h5>
                </div>
                <div class="card-body">
                    <textarea asp-for="TermsAndConditions" class="form-control" rows="6" placeholder="Enter terms and conditions"></textarea>
                    <span asp-validation-for="TermsAndConditions" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 mb-4">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calculator me-2"></i>Quotation Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="quotation-totals">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span class="fw-bold" id="subtotal-display">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (<span id="tax-rate-display">18</span>%):</span>
                            <span class="fw-bold" id="tax-display">₹0.00</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <span class="h5 fw-bold">Total:</span>
                            <span class="h5 fw-bold text-success" id="total-display">₹0.00</span>
                        </div>
                    </div>
                    
                    <!-- Hidden fields for totals -->
                    <input asp-for="SubTotal" type="hidden" id="subtotal-input">
                    <input asp-for="TaxAmount" type="hidden" id="tax-input">
                    <input asp-for="TotalAmount" type="hidden" id="total-input">
                </div>
            </div>
        </div>
    </div>

    <!-- Form Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-soft">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                All fields marked with * are required
                            </small>
                        </div>
                        <div class="btn-toolbar gap-2 no-print">
                            <div class="btn-group">
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                            </div>
                            <div class="btn-group">
                                <button type="submit" class="btn btn-primary" id="save-btn">
                                    <i class="fas fa-save me-2"></i>
                                    <span class="btn-text">Save Quotation</span>
                                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="btn btn-success" id="save-and-download-btn" disabled>
                                    <i class="fas fa-download me-2"></i>
                                    <span class="btn-text">Save & Download PDF</span>
                                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="btn btn-info" id="print-btn" disabled>
                                    <i class="fas fa-print me-2"></i>Print
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Hidden template for line items -->
<template id="line-item-template">
    <tr class="line-item-row" data-item-type="product">
        <td class="text-center">
            <span class="line-number">1</span>
        </td>
        <td class="text-center">
            <span class="badge bg-primary" title="Catalog Product">
                <i class="fas fa-box"></i>
            </span>
        </td>
        <td>
            <div class="d-flex gap-1">
                <select class="form-select form-select-sm product-select flex-grow-1" name="lineItems[0].ProductId" required>
                    <option value="">-- Select Product --</option>
                    @foreach (var product in (ViewBag.Products as List<Product>) ?? new List<Product>())
                    {
                        <option value="@product.Id" data-price="@product.UnitPrice" data-unit="@product.Unit" data-description="@product.Description">
                            @product.Name (@product.Code)
                        </option>
                    }
                </select>
                <button type="button" class="btn btn-outline-primary btn-sm create-product-btn" title="Create New Product">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </td>
        <td>
            <input type="text" class="form-control form-control-sm line-description" name="lineItems[0].Description" placeholder="Description">
        </td>
        <td>
            <input type="number" class="form-control form-control-sm quantity-input" name="lineItems[0].Quantity" min="0.01" step="0.01" value="1" required>
        </td>
        <td>
            <input type="text" class="form-control form-control-sm unit-input" name="lineItems[0].Unit" readonly>
        </td>
        <td>
            <input type="number" class="form-control form-control-sm price-input" name="lineItems[0].UnitPrice" min="0" step="0.01" required>
        </td>
        <td>
            <span class="line-total fw-bold">₹0.00</span>
            <input type="hidden" class="line-total-input" name="lineItems[0].LineTotal" value="0">
        </td>
        <td class="text-center no-print">
            <button type="button" class="btn btn-outline-danger btn-sm remove-line-item" title="Remove Item">
                <i class="fas fa-trash"></i>
            </button>
        </td>
    </tr>
</template>

<!-- Hidden template for custom line items -->
<template id="custom-line-item-template">
    <tr class="line-item-row custom-item-row" data-item-type="custom">
        <td class="text-center">
            <span class="line-number">1</span>
        </td>
        <td class="text-center">
            <span class="badge bg-success" title="Custom Item">
                <i class="fas fa-edit"></i>
            </span>
        </td>
        <td>
            <input type="text" class="form-control form-control-sm custom-item-name" name="lineItems[0].CustomItemName" placeholder="Item name/description" required>
            <input type="hidden" name="lineItems[0].ProductId" value="">
        </td>
        <td>
            <textarea class="form-control form-control-sm line-description" name="lineItems[0].Description" placeholder="Additional notes or specifications" rows="1"></textarea>
        </td>
        <td>
            <input type="number" class="form-control form-control-sm quantity-input" name="lineItems[0].Quantity" min="0.01" step="0.01" value="1" required>
        </td>
        <td>
            <select class="form-select form-select-sm unit-input" name="lineItems[0].Unit" required>
                <option value="">-- Unit --</option>
                <option value="Piece">Piece</option>
                <option value="Meter">Meter</option>
                <option value="Foot">Foot</option>
                <option value="Inch">Inch</option>
                <option value="Kg">Kilogram</option>
                <option value="Liter">Liter</option>
                <option value="Hour">Hour</option>
                <option value="Day">Day</option>
                <option value="Set">Set</option>
                <option value="Box">Box</option>
                <option value="Roll">Roll</option>
                <option value="Sheet">Sheet</option>
                <option value="Sq Ft">Square Foot</option>
                <option value="Sq M">Square Meter</option>
                <option value="Linear Ft">Linear Foot</option>
                <option value="Linear M">Linear Meter</option>
            </select>
        </td>
        <td>
            <input type="number" class="form-control form-control-sm price-input" name="lineItems[0].UnitPrice" min="0" step="0.01" placeholder="0.00" required>
        </td>
        <td>
            <span class="line-total fw-bold">₹0.00</span>
            <input type="hidden" class="line-total-input" name="lineItems[0].LineTotal" value="0">
        </td>
        <td class="text-center no-print">
            <button type="button" class="btn btn-outline-danger btn-sm remove-line-item" title="Remove Item">
                <i class="fas fa-trash"></i>
            </button>
        </td>
    </tr>
</template>



<style>
/* Quotation Create Specific Styles */
.customer-info-card {
    background: linear-gradient(135deg, var(--light-color) 0%, #f1f5f9 100%);
    border-radius: var(--border-radius);
    padding: 1rem;
    border: 1px solid var(--border-color);
}

.quotation-totals {
    background: var(--light-color);
    border-radius: var(--border-radius);
    padding: 1rem;
}

.line-item-row {
    transition: all 0.2s ease;
}

.line-item-row:hover {
    background-color: var(--bs-gray-50);
}

.product-select, .quantity-input, .price-input, .line-description, .unit-input {
    border: 1px solid #dee2e6;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
}

.product-select:focus, .quantity-input:focus, .price-input:focus, .line-description:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 0.2rem rgba(var(--primary-rgb), 0.25);
}

.line-total {
    font-family: 'Courier New', monospace;
    color: var(--success-color);
}

.remove-line-item {
    transition: all 0.2s ease;
}

.remove-line-item:hover {
    transform: scale(1.1);
}

.tax-info-display {
    background: var(--bs-gray-100);
    border-radius: var(--border-radius-sm);
    padding: 0.5rem;
}

#empty-line-items {
    background: linear-gradient(135deg, var(--light-color) 0%, #f8fafc 100%);
}

.form-check-input:checked {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.btn-group .btn {
    min-width: 120px;
}

@@media (max-width: 768px) {
    .table-responsive {
        font-size: 0.875rem;
    }

    .btn-group {
        flex-direction: column;
        width: 100%;
    }

    .btn-group .btn {
        margin-bottom: 0.5rem;
    }

    .quotation-totals {
        margin-top: 1rem;
    }
}

@@media (max-width: 576px) {
    .display-6 {
        font-size: 1.5rem;
    }

    .card-header h5 {
        font-size: 1rem;
    }

    .table th, .table td {
        padding: 0.5rem 0.25rem;
        font-size: 0.8rem;
    }

    .form-control-sm {
        font-size: 0.8rem;
    }
}

/* Modal Styling */
.modal-header {
    border-bottom: 2px solid rgba(255, 255, 255, 0.2);
}

.modal-footer {
    border-top: 1px solid var(--border-color);
}

.modal-body .form-label {
    font-weight: 600;
    color: var(--dark-color);
}

.modal-body .form-control:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 0.2rem rgba(var(--primary-rgb), 0.25);
}

.modal-body .is-invalid {
    border-color: var(--danger-color);
}

.modal-body .is-valid {
    border-color: var(--success-color);
}

.btn-close-white {
    filter: invert(1) grayscale(100%) brightness(200%);
}

/* Inline creation buttons */
.create-product-btn {
    min-width: 32px;
    height: 32px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.create-product-btn:hover {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    color: white;
}

/* Toast styling */
.toast-container {
    z-index: 1055;
}

.toast {
    min-width: 300px;
}

.toast-body {
    font-weight: 500;
}

/* Custom line item styling */
.custom-item-row {
    background-color: rgba(25, 135, 84, 0.05);
}

.custom-item-row:hover {
    background-color: rgba(25, 135, 84, 0.1);
}

.custom-item-name {
    font-weight: 600;
}

.line-item-row[data-item-type="custom"] .line-description {
    resize: vertical;
    min-height: 32px;
}

/* Badge styling for item types */
.badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
}

/* Button group styling */
.btn-group .btn {
    border-radius: 0;
}

.btn-group .btn:first-child {
    border-top-left-radius: var(--border-radius);
    border-bottom-left-radius: var(--border-radius);
}

.btn-group .btn:last-child {
    border-top-right-radius: var(--border-radius);
    border-bottom-right-radius: var(--border-radius);
}

/* Button States */
.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.btn .spinner-border {
    width: 1rem;
    height: 1rem;
}

/* Print Styles */
@@media print {
    .no-print {
        display: none !important;
    }

    .print-only {
        display: block !important;
    }

    body {
        background: white !important;
        color: black !important;
        font-size: 12pt;
    }

    .container-fluid {
        max-width: none !important;
        padding: 0 !important;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
    }

    .table {
        border-collapse: collapse !important;
    }

    .table th,
    .table td {
        border: 1px solid #000 !important;
        padding: 8px !important;
    }

    .page-break {
        page-break-before: always;
    }
}
</style>

<!-- Customer Creation Modal -->
<div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title" id="customerModalLabel">
                    <i class="fas fa-user-plus me-2"></i>Create New Customer
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="customerForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="customerName" class="form-label fw-semibold">
                                <i class="fas fa-user me-1"></i>Full Name *
                            </label>
                            <input type="text" class="form-control" id="customerName" name="name" required>
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="customerCompany" class="form-label fw-semibold">
                                <i class="fas fa-building me-1"></i>Company Name
                            </label>
                            <input type="text" class="form-control" id="customerCompany" name="companyName">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="customerEmail" class="form-label fw-semibold">
                                <i class="fas fa-envelope me-1"></i>Email Address *
                            </label>
                            <input type="email" class="form-control" id="customerEmail" name="email" required>
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="customerPhone" class="form-label fw-semibold">
                                <i class="fas fa-phone me-1"></i>Phone Number
                            </label>
                            <input type="tel" class="form-control" id="customerPhone" name="phone">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="customerAddress" class="form-label fw-semibold">
                            <i class="fas fa-map-marker-alt me-1"></i>Address
                        </label>
                        <textarea class="form-control" id="customerAddress" name="address" rows="2"></textarea>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="customerCity" class="form-label fw-semibold">
                                <i class="fas fa-city me-1"></i>City
                            </label>
                            <input type="text" class="form-control" id="customerCity" name="city">
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="customerState" class="form-label fw-semibold">
                                <i class="fas fa-map me-1"></i>State
                            </label>
                            <input type="text" class="form-control" id="customerState" name="state">
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="customerPostalCode" class="form-label fw-semibold">
                                <i class="fas fa-mail-bulk me-1"></i>Postal Code
                            </label>
                            <input type="text" class="form-control" id="customerPostalCode" name="postalCode" maxlength="6">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveCustomerBtn">
                    <i class="fas fa-save me-2"></i>
                    <span class="btn-text">Create Customer</span>
                    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Product Creation Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-success text-white">
                <h5 class="modal-title" id="productModalLabel">
                    <i class="fas fa-box me-2"></i>Create New Product
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="productForm">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="productName" class="form-label fw-semibold">
                                <i class="fas fa-box me-1"></i>Product Name *
                            </label>
                            <input type="text" class="form-control" id="productName" name="name" required>
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="productCode" class="form-label fw-semibold">
                                <i class="fas fa-barcode me-1"></i>Product Code
                            </label>
                            <input type="text" class="form-control" id="productCode" name="code">
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label for="productCategory" class="form-label fw-semibold mb-0">
                                    <i class="fas fa-tags me-1"></i>Category *
                                </label>
                                <button type="button" class="btn btn-outline-info btn-sm" id="create-category-btn">
                                    <i class="fas fa-plus me-1"></i>New Category
                                </button>
                            </div>
                            <select class="form-select" id="productCategory" name="categoryId" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var category in (ViewBag.Categories as List<ProductCategory>) ?? new List<ProductCategory>())
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="productUnit" class="form-label fw-semibold">
                                <i class="fas fa-ruler me-1"></i>Unit of Measurement
                            </label>
                            <select class="form-select" id="productUnit" name="unit">
                                <option value="">-- Select Unit --</option>
                                <option value="Piece">Piece</option>
                                <option value="Meter">Meter</option>
                                <option value="Foot">Foot</option>
                                <option value="Inch">Inch</option>
                                <option value="Kg">Kilogram</option>
                                <option value="Liter">Liter</option>
                                <option value="Hour">Hour</option>
                                <option value="Day">Day</option>
                                <option value="Set">Set</option>
                                <option value="Box">Box</option>
                            </select>
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="productPrice" class="form-label fw-semibold">
                                <i class="fas fa-rupee-sign me-1"></i>Unit Price *
                            </label>
                            <input type="number" class="form-control" id="productPrice" name="unitPrice" min="0" step="0.01" required>
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="productIsService" name="isService">
                                <label class="form-check-label fw-semibold" for="productIsService">
                                    <i class="fas fa-tools me-1"></i>This is a service
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="productDescription" class="form-label fw-semibold">
                            <i class="fas fa-align-left me-1"></i>Description
                        </label>
                        <textarea class="form-control" id="productDescription" name="description" rows="3"></textarea>
                        <div class="invalid-feedback"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" id="saveProductBtn">
                    <i class="fas fa-save me-2"></i>
                    <span class="btn-text">Create Product</span>
                    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Category Creation Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-gradient-info text-white">
                <h5 class="modal-title" id="categoryModalLabel">
                    <i class="fas fa-tags me-2"></i>Create New Category
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label fw-semibold">
                            <i class="fas fa-tag me-1"></i>Category Name *
                        </label>
                        <input type="text" class="form-control" id="categoryName" name="name" required>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="categoryServiceType" class="form-label fw-semibold">
                            <i class="fas fa-cogs me-1"></i>Service Type
                        </label>
                        <select class="form-select" id="categoryServiceType" name="serviceType">
                            <option value="">-- Select Service Type --</option>
                            <option value="Plumbing">Plumbing</option>
                            <option value="Electrical">Electrical</option>
                            <option value="HVAC">HVAC</option>
                            <option value="General">General</option>
                            <option value="Materials">Materials</option>
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="categoryDescription" class="form-label fw-semibold">
                            <i class="fas fa-align-left me-1"></i>Description
                        </label>
                        <textarea class="form-control" id="categoryDescription" name="description" rows="2"></textarea>
                        <div class="invalid-feedback"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-info" id="saveCategoryBtn">
                    <i class="fas fa-save me-2"></i>
                    <span class="btn-text">Create Category</span>
                    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/quotation-create.js"></script>
    <script src="~/js/quotation-inline-creation.js"></script>
    <script src="~/js/quotation-save-actions.js"></script>
    <script>
        // Initialize save actions when DOM is ready
        $(document).ready(function() {
            window.quotationSaveActions = new QuotationSaveActions();
            console.log('QuotationSaveActions initialized');
        });
    </script>
}
