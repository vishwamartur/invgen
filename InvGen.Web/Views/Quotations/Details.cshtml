@model Quotation
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Quotation Details";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-6 fw-bold text-gradient mb-2">
                    <i class="fas fa-file-invoice me-3"></i>Quotation Details
                </h1>
                <p class="lead text-muted mb-0">
                    <strong>@Model.QuotationNumber</strong>
                    <span class="badge status-@Model.Status.ToString().ToLower() badge-lg ms-2">@Model.Status</span>
                </p>
            </div>
            <div class="d-none d-md-block">
                <div class="btn-group">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-primary">
                        <i class="fas fa-edit me-2"></i>Edit
                    </a>
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-info" onclick="printQuotation()">
                            <i class="fas fa-print me-2"></i>Print
                        </button>
                        <button type="button" class="btn btn-outline-info dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" onclick="printPreview(); return false;"><i class="fas fa-eye me-2"></i>Print Preview</a></li>
                            <li><a class="dropdown-item" href="#" onclick="printQuotation(); return false;"><i class="fas fa-print me-2"></i>Print Now</a></li>
                        </ul>
                    </div>
                    <a href="@Url.Action("Pdf", new { id = Model.Id })" class="btn btn-outline-success" target="_blank">
                        <i class="fas fa-file-pdf me-2"></i>PDF
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Action Buttons -->
<div class="d-block d-md-none mb-4">
    <div class="row g-2">
        <div class="col-6">
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-primary w-100">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
        </div>
        <div class="col-6">
            <div class="dropdown w-100">
                <button class="btn btn-outline-info dropdown-toggle w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-print me-1"></i>Print
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" onclick="printPreview(); return false;"><i class="fas fa-eye me-2"></i>Preview</a></li>
                    <li><a class="dropdown-item" href="#" onclick="printQuotation(); return false;"><i class="fas fa-print me-2"></i>Print</a></li>
                </ul>
            </div>
        </div>
        <div class="col-6">
            <a href="@Url.Action("Pdf", new { id = Model.Id })" class="btn btn-outline-success w-100" target="_blank">
                <i class="fas fa-file-pdf me-1"></i>PDF
            </a>
        </div>
        <div class="col-6">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">
                <i class="fas fa-arrow-left me-1"></i>Back
            </a>
        </div>
    </div>
</div>

<!-- Print-Only Company Header -->
<div class="print-only d-none">
    <div class="company-header text-center mb-4">
        <h1 class="company-name">@(Configuration["CompanySettings:Name"] ?? "Your Company Name")</h1>
        <div class="company-details">
            <p class="mb-1">@(Configuration["CompanySettings:Address"] ?? "Your Company Address")</p>
            <p class="mb-1">
                Phone: @(Configuration["CompanySettings:Phone"] ?? "Your Phone Number") |
                Email: @(Configuration["CompanySettings:Email"] ?? "your.email@company.com")
            </p>
            @if (!string.IsNullOrEmpty(Configuration["CompanySettings:Website"]))
            {
                <p class="mb-0">Website: @Configuration["CompanySettings:Website"]</p>
            }
        </div>
        <hr class="my-3">
        <h2 class="quotation-title">QUOTATION</h2>
    </div>
</div>

<!-- Print-Only Quotation Header -->
<div class="print-only d-none">
    <div class="row mb-3">
        <div class="col-6">
            <strong>Quotation No:</strong> @Model.QuotationNumber<br>
            <strong>Date:</strong> @Model.QuotationDate.ToString("dd/MM/yyyy")<br>
            @if (Model.ValidUntil.HasValue)
            {
                <strong>Valid Until:</strong> @Model.ValidUntil.Value.ToString("dd/MM/yyyy")<br>
            }
            @if (!string.IsNullOrEmpty(Model.ProjectName))
            {
                <strong>Project:</strong> @Model.ProjectName
            }
        </div>
        <div class="col-6 text-end">
            <strong>Status:</strong> @Model.Status<br>
            <strong>Created:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy")
        </div>
    </div>
</div>

<!-- Print-Only Customer Information -->
<div class="print-only d-none mb-4">
    <div class="row">
        <div class="col-12">
            <h3>Bill To:</h3>
            <div class="customer-print-info">
                <strong>@Model.Customer?.CompanyName</strong><br>
                @Model.Customer?.Name<br>
                @if (!string.IsNullOrEmpty(Model.Customer?.Address))
                {
                    @Html.Raw(Model.Customer.Address.Replace("\n", "<br>"))<br>
                }
                Phone: @Model.Customer?.Phone
                @if (!string.IsNullOrEmpty(Model.Customer?.Mobile))
                {
                    <text> | Mobile: @Model.Customer.Mobile</text>
                }
                <br>
                Email: @Model.Customer?.Email
            </div>
        </div>
    </div>
    <hr class="my-3">
</div>

<!-- Quotation Information (Screen Only) -->
<div class="row mb-4 no-print">
    <!-- Customer Information -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-soft h-100">
            <div class="card-header bg-gradient-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-user me-2"></i>Customer Information
                </h5>
            </div>
            <div class="card-body">
                <div class="customer-info-card">
                    <div class="row">
                        <div class="col-12">
                            <h6 class="fw-bold text-primary mb-2">@Model.Customer?.CompanyName</h6>
                            <p class="mb-1"><strong>Contact:</strong> @Model.Customer?.Name</p>
                            <p class="mb-1"><strong>Email:</strong> @Model.Customer?.Email</p>
                            <p class="mb-1"><strong>Phone:</strong> @Model.Customer?.Phone</p>
                            @if (!string.IsNullOrEmpty(Model.Customer?.Mobile))
                            {
                                <p class="mb-1"><strong>Mobile:</strong> @Model.Customer.Mobile</p>
                            }
                            <p class="mb-1"><strong>Address:</strong> @Model.Customer?.Address</p>
                            <p class="mb-1">@Model.Customer?.City, @Model.Customer?.State @Model.Customer?.PostalCode</p>
                            @if (!string.IsNullOrEmpty(Model.Customer?.GstNumber))
                            {
                                <p class="mb-0 text-muted"><strong>GST:</strong> @Model.Customer.GstNumber</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Project & Quotation Details -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-soft h-100">
            <div class="card-header bg-gradient-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-project-diagram me-2"></i>Project & Quotation Details
                </h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ProjectName))
                {
                    <div class="mb-3">
                        <strong>Project Name:</strong>
                        <p class="mb-0">@Model.ProjectName</p>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p class="mb-0">@Model.Description</p>
                    </div>
                }
                
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <strong>Quotation Date:</strong>
                        <p class="mb-0">@Model.QuotationDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Valid Until:</strong>
                        <p class="mb-0">@Model.ValidUntil?.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Created:</strong>
                        <p class="mb-0">@Model.CreatedDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Last Updated:</strong>
                        <p class="mb-0">@Model.UpdatedDate?.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Print-Only Line Items -->
<div class="print-only d-none">
    @if (Model.LineItems?.Any() == true)
    {
        <div class="line-items-print">
            <h3>Items:</h3>
            <table class="table-print">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 35%;">Description</th>
                        <th style="width: 15%;">Qty</th>
                        <th style="width: 10%;">Unit</th>
                        <th style="width: 15%;">Rate</th>
                        <th style="width: 20%;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LineItems.OrderBy(li => li.SortOrder))
                    {
                        <tr>
                            <td>@item.SortOrder</td>
                            <td>
                                <strong>@item.Product?.Name</strong>
                                @if (!string.IsNullOrEmpty(item.Product?.Code))
                                {
                                    <br><small>(@item.Product.Code)</small>
                                }
                                @if (!string.IsNullOrEmpty(item.Description) && item.Description != item.Product?.Name)
                                {
                                    <br><small>@item.Description</small>
                                }
                            </td>
                            <td>@item.Quantity</td>
                            <td>@item.Unit</td>
                            <td>₹@item.UnitPrice.ToString("N2")</td>
                            <td>₹@item.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="page-break"></div>
    }
</div>

<!-- Line Items (Screen Only) -->
<div class="row mb-4 no-print">
    <div class="col-12">
        <div class="card shadow-soft">
            <div class="card-header bg-gradient-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>Line Items
                    </h5>
                    <span class="badge bg-light text-dark">@Model.LineItems?.Count() items</span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.LineItems?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th width="5%">#</th>
                                    <th width="25%">Product</th>
                                    <th width="20%">Description</th>
                                    <th width="10%">Qty</th>
                                    <th width="10%">Unit</th>
                                    <th width="12%">Unit Price</th>
                                    <th width="12%">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LineItems.OrderBy(li => li.SortOrder))
                                {
                                    <tr>
                                        <td class="text-center">@item.SortOrder</td>
                                        <td>
                                            <strong>@item.Product?.Name</strong>
                                            @if (!string.IsNullOrEmpty(item.Product?.Code))
                                            {
                                                <br><small class="text-muted">(@item.Product.Code)</small>
                                            }
                                        </td>
                                        <td>@item.Description</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td>@item.Unit</td>
                                        <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                                        <td class="text-end fw-bold">₹@item.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No line items</h5>
                        <p class="text-muted">This quotation doesn't have any line items yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Print-Only Totals -->
<div class="print-only d-none">
    <div class="totals-print">
        <table class="totals-table">
            <tr>
                <td><strong>Subtotal:</strong></td>
                <td class="text-end"><strong>₹@Model.SubTotal.ToString("N2")</strong></td>
            </tr>
            <tr>
                <td><strong>Tax (@Model.TaxRate%):</strong></td>
                <td class="text-end"><strong>₹@Model.TaxAmount.ToString("N2")</strong></td>
            </tr>
            <tr class="total-row">
                <td><strong>TOTAL AMOUNT:</strong></td>
                <td class="text-end"><strong>₹@Model.TotalAmount.ToString("N2")</strong></td>
            </tr>
        </table>
        <p class="tax-note">
            <small>@(Model.IsTaxInclusive ? "Tax inclusive pricing" : "Tax exclusive pricing")</small>
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.TermsAndConditions))
    {
        <div class="terms-print mt-4">
            <h4>Terms and Conditions:</h4>
            <div class="terms-content-print">
                @Html.Raw(Model.TermsAndConditions.Replace("\n", "<br>"))
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="notes-print mt-3">
            <h4>Notes:</h4>
            <div class="notes-content-print">
                @Html.Raw(Model.Notes.Replace("\n", "<br>"))
            </div>
        </div>
    }
</div>

<!-- Terms and Totals (Screen Only) -->
<div class="row mb-4 no-print">
    <div class="col-lg-8 mb-4">
        @if (!string.IsNullOrEmpty(Model.TermsAndConditions))
        {
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-contract me-2 text-primary"></i>Terms and Conditions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="terms-content">
                        @Html.Raw(Model.TermsAndConditions.Replace("\n", "<br>"))
                    </div>
                </div>
            </div>
        }
    </div>
    
    <div class="col-lg-4 mb-4">
        <div class="card shadow-soft">
            <div class="card-header bg-gradient-success text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-calculator me-2"></i>Quotation Summary
                </h5>
            </div>
            <div class="card-body">
                <div class="quotation-totals">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span class="fw-bold">₹@Model.SubTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax (@Model.TaxRate%):</span>
                        <span class="fw-bold">₹@Model.TaxAmount.ToString("N2")</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="h5 fw-bold">Total:</span>
                        <span class="h5 fw-bold text-success">₹@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
                
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        @(Model.IsTaxInclusive ? "Tax inclusive pricing" : "Tax exclusive pricing")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Actions (Screen Only) -->
@if (Model.Status == QuotationStatus.Draft || Model.Status == QuotationStatus.Sent)
{
    <div class="row mb-4 no-print">
        <div class="col-12">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-warning text-dark">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-tasks me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        @if (Model.Status == QuotationStatus.Draft)
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@QuotationStatus.Sent" />
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fas fa-paper-plane me-1"></i>Mark as Sent
                                </button>
                            </form>
                        }
                        
                        @if (Model.Status == QuotationStatus.Sent)
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@QuotationStatus.Approved" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fas fa-check me-1"></i>Mark as Approved
                                </button>
                            </form>
                            
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@QuotationStatus.Rejected" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-times me-1"></i>Mark as Rejected
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* Details-specific styles */
.customer-info-card {
    background: linear-gradient(135deg, var(--light-color) 0%, #f1f5f9 100%);
    border-radius: var(--border-radius);
    padding: 1.5rem;
    border: 1px solid var(--border-color);
}

.quotation-totals {
    background: var(--light-color);
    border-radius: var(--border-radius);
    padding: 1.5rem;
}

.terms-content {
    line-height: 1.6;
    color: var(--dark-color);
}

.btn-group .btn {
    min-width: 100px;
}

@@media (max-width: 768px) {
    .btn-group {
        flex-direction: column;
        width: 100%;
    }
    
    .btn-group .btn {
        margin-bottom: 0.5rem;
    }
    
    .table-responsive {
        font-size: 0.875rem;
    }
}

/* Print Styles */
@@media print {
    /* Hide screen-only elements */
    .no-print,
    .navbar,
    .footer,
    .btn,
    .alert,
    .quick-actions,
    .filter-controls,
    .card-header,
    .badge {
        display: none !important;
    }

    /* Show print-only elements */
    .print-only {
        display: block !important;
    }

    /* Page setup */
    @@page {
        margin: 0.5in;
        size: A4;
    }

    body {
        background: white !important;
        color: black !important;
        font-size: 12pt;
        line-height: 1.4;
        font-family: Arial, sans-serif;
    }

    .container-fluid {
        max-width: none !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    /* Company Header Styles */
    .company-header {
        border-bottom: 2px solid #000;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .company-name {
        font-size: 24pt;
        font-weight: bold;
        margin-bottom: 10px;
        color: #000;
    }

    .company-details {
        font-size: 11pt;
        line-height: 1.3;
    }

    .quotation-title {
        font-size: 18pt;
        font-weight: bold;
        margin: 15px 0 10px 0;
        text-align: center;
        color: #000;
    }

    /* Customer Information */
    .customer-print-info {
        font-size: 11pt;
        line-height: 1.4;
        margin-bottom: 15px;
    }

    /* Line Items Table */
    .table-print {
        width: 100%;
        border-collapse: collapse;
        margin: 15px 0;
        font-size: 10pt;
    }

    .table-print th,
    .table-print td {
        border: 1px solid #000;
        padding: 8px 6px;
        text-align: left;
        vertical-align: top;
    }

    .table-print th {
        background-color: #f0f0f0;
        font-weight: bold;
        text-align: center;
    }

    .table-print td:nth-child(3),
    .table-print td:nth-child(5),
    .table-print td:nth-child(6) {
        text-align: right;
    }

    /* Totals Table */
    .totals-table {
        width: 100%;
        max-width: 300px;
        margin-left: auto;
        margin-top: 20px;
        font-size: 11pt;
    }

    .totals-table td {
        padding: 5px 10px;
        border-bottom: 1px solid #ccc;
    }

    .totals-table .total-row td {
        border-top: 2px solid #000;
        border-bottom: 2px solid #000;
        font-size: 12pt;
        font-weight: bold;
        padding: 8px 10px;
    }

    /* Terms and Notes */
    .terms-print,
    .notes-print {
        margin-top: 25px;
        page-break-inside: avoid;
    }

    .terms-print h4,
    .notes-print h4 {
        font-size: 12pt;
        font-weight: bold;
        margin-bottom: 8px;
        color: #000;
    }

    .terms-content-print,
    .notes-content-print {
        font-size: 10pt;
        line-height: 1.4;
    }

    .tax-note {
        font-size: 9pt;
        margin-top: 10px;
        text-align: right;
        font-style: italic;
    }

    /* Page breaks */
    .page-break {
        page-break-before: always;
    }

    /* Remove card styling */
    .card {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
    }

    .card-body {
        padding: 0 !important;
    }

    /* Headers */
    h1, h2, h3, h4, h5, h6 {
        color: #000 !important;
        page-break-after: avoid;
    }

    /* Avoid breaking inside important elements */
    .customer-print-info,
    .totals-print,
    .terms-print,
    .notes-print {
        page-break-inside: avoid;
    }
}
</style>

<script>
function printQuotation() {
    try {
        // Show print-only elements and hide no-print elements
        const printOnlyElements = document.querySelectorAll('.print-only');
        const noPrintElements = document.querySelectorAll('.no-print');

        // Store original display values
        const originalDisplayValues = new Map();

        // Show print-only elements
        printOnlyElements.forEach(element => {
            originalDisplayValues.set(element, element.style.display);
            element.style.display = 'block';
            element.classList.remove('d-none');
        });

        // Hide no-print elements
        noPrintElements.forEach(element => {
            originalDisplayValues.set(element, element.style.display);
            element.style.display = 'none';
        });

        // Set page title for print
        const originalTitle = document.title;
        document.title = 'Quotation @Model.QuotationNumber - @Model.Customer?.CompanyName';

        // Show loading indicator on print button
        const printButton = document.querySelector('button[onclick="printQuotation()"]');
        if (printButton) {
            const originalButtonText = printButton.innerHTML;
            printButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Preparing...';
            printButton.disabled = true;

            // Restore button after print
            setTimeout(() => {
                printButton.innerHTML = originalButtonText;
                printButton.disabled = false;
            }, 2000);
        }

        // Trigger print dialog
        window.print();

        // Restore original state after print dialog
        setTimeout(() => {
            // Restore original display values
            originalDisplayValues.forEach((originalDisplay, element) => {
                if (element.classList.contains('print-only')) {
                    element.style.display = 'none';
                    element.classList.add('d-none');
                } else if (element.classList.contains('no-print')) {
                    element.style.display = originalDisplay || '';
                }
            });

            // Restore original title
            document.title = originalTitle;
        }, 1000);

    } catch (error) {
        console.error('Error during print:', error);
        alert('An error occurred while preparing the document for printing. Please try again.');
    }
}

// Print Preview Function
function printPreview() {
    try {
        // Create a new window for print preview
        const printWindow = window.open('', '_blank', 'width=800,height=600,scrollbars=yes,resizable=yes');

        if (!printWindow) {
            alert('Please allow popups for print preview to work.');
            return;
        }

        // Get the current page content
        const currentContent = document.documentElement.outerHTML;

        // Create print preview content
        const printContent = currentContent
            .replace(/class="print-only d-none"/g, 'class="print-only"')
            .replace(/class="([^"]*\s+)?no-print(\s+[^"]*)?"[^>]*>/g, 'style="display: none;">')
            .replace(/<style>/g, '<style>body { margin: 20px; } .print-only { display: block !important; } .no-print { display: none !important; }');

        // Write content to new window
        printWindow.document.write(printContent);
        printWindow.document.close();

        // Set title
        printWindow.document.title = 'Print Preview - Quotation @Model.QuotationNumber';

        // Focus the new window
        printWindow.focus();

    } catch (error) {
        console.error('Error during print preview:', error);
        alert('An error occurred while generating print preview. Please try direct printing instead.');
    }
}

// Handle browser's beforeprint and afterprint events for better compatibility
window.addEventListener('beforeprint', function() {
    document.querySelectorAll('.print-only').forEach(element => {
        element.style.display = 'block';
        element.classList.remove('d-none');
    });

    document.querySelectorAll('.no-print').forEach(element => {
        element.style.display = 'none';
    });
});

window.addEventListener('afterprint', function() {
    document.querySelectorAll('.print-only').forEach(element => {
        element.style.display = 'none';
        element.classList.add('d-none');
    });

    document.querySelectorAll('.no-print').forEach(element => {
        element.style.display = '';
    });
});

// Keyboard shortcut for print (Ctrl+P)
document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.key === 'p') {
        e.preventDefault();
        printQuotation();
    }
});
</script>
