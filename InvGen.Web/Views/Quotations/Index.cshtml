@model IEnumerable<InvGen.Web.Models.Quotation>

@{
    ViewData["Title"] = "Quotations";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-file-invoice me-2 text-primary"></i>Quotations
            </h2>
            <p class="text-muted mb-0">Manage your quotations and estimates</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>New Quotation
            </a>
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-filter me-2"></i>Filter
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="@Url.Action("Index")">All Quotations</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Draft" })">Draft</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Sent" })">Sent</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Approved" })">Approved</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Rejected" })">Rejected</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card shadow-soft mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" class="form-control search-input" placeholder="Search quotations..." 
                               data-search-type="quotations" id="quotationSearch">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="statusFilter">
                        <option value="">All Status</option>
                        <option value="Draft">Draft</option>
                        <option value="Sent">Sent</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Expired">Expired</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="customerFilter">
                        <option value="">All Customers</option>
                        @foreach (var customer in ViewBag.Customers as IEnumerable<InvGen.Web.Models.Customer> ?? Enumerable.Empty<InvGen.Web.Models.Customer>())
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-1"></i>Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Quotations Table -->
    <div class="card shadow-soft">
        <div class="card-header bg-gradient-light">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-list me-2"></i>Quotations List
                </h5>
                <div class="d-flex align-items-center gap-3">
                    <small class="text-muted">
                        <span id="quotationCount">@Model.Count()</span> quotations found
                    </small>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary active" onclick="toggleView('table')">
                            <i class="fas fa-table"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <!-- Table View -->
                <div id="tableView" class="table-responsive">
                    <table class="table table-hover mb-0" id="quotationsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="sortable" data-sort="quotationNumber">
                                    <i class="fas fa-sort me-1"></i>Quotation #
                                </th>
                                <th class="sortable" data-sort="customer">
                                    <i class="fas fa-sort me-1"></i>Customer
                                </th>
                                <th class="sortable" data-sort="date">
                                    <i class="fas fa-sort me-1"></i>Date
                                </th>
                                <th class="sortable" data-sort="amount">
                                    <i class="fas fa-sort me-1"></i>Amount
                                </th>
                                <th class="sortable" data-sort="status">
                                    <i class="fas fa-sort me-1"></i>Status
                                </th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var quotation in Model)
                            {
                                <tr class="quotation-row" 
                                    data-status="@quotation.Status" 
                                    data-customer="@quotation.CustomerId"
                                    data-search="@quotation.QuotationNumber @quotation.Customer.Name @quotation.ProjectName">
                                    <td>
                                        <div class="fw-medium text-primary">@quotation.QuotationNumber</div>
                                        @if (!string.IsNullOrEmpty(quotation.ProjectName))
                                        {
                                            <small class="text-muted">@quotation.ProjectName</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="customer-avatar me-2">
                                                @quotation.Customer.Name.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-medium">@quotation.Customer.Name</div>
                                                @if (!string.IsNullOrEmpty(quotation.Customer.CompanyName))
                                                {
                                                    <small class="text-muted">@quotation.Customer.CompanyName</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>@quotation.QuotationDate.ToString("MMM dd, yyyy")</div>
                                        @if (quotation.ValidUntil.HasValue)
                                        {
                                            <small class="text-muted">Valid until: @quotation.ValidUntil.Value.ToString("MMM dd, yyyy")</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-success">₹@quotation.TotalAmount.ToString("N2")</div>
                                        @if (quotation.TaxAmount > 0)
                                        {
                                            <small class="text-muted">Tax: ₹@quotation.TaxAmount.ToString("N2")</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge status-@quotation.Status.ToString().ToLower() badge-lg">
                                            @quotation.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = quotation.Id })" 
                                               class="btn btn-outline-primary" 
                                               data-bs-toggle="tooltip" 
                                               title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = quotation.Id })" 
                                               class="btn btn-outline-secondary"
                                               data-bs-toggle="tooltip" 
                                               title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="@Url.Action("Pdf", new { id = quotation.Id })"
                                               class="btn btn-outline-info"
                                               data-bs-toggle="tooltip"
                                               title="Download PDF">
                                                <i class="fas fa-file-pdf"></i>
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-outline-danger" 
                                                    onclick="deleteQuotation(@quotation.Id)"
                                                    data-bs-toggle="tooltip" 
                                                    title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Grid View (Hidden by default) -->
                <div id="gridView" class="d-none p-3">
                    <div class="row g-3">
                        @foreach (var quotation in Model)
                        {
                            <div class="col-xl-3 col-lg-4 col-md-6 quotation-card" 
                                 data-status="@quotation.Status" 
                                 data-customer="@quotation.CustomerId"
                                 data-search="@quotation.QuotationNumber @quotation.Customer.Name @quotation.ProjectName">
                                <div class="card h-100 shadow-soft">
                                    <div class="card-header bg-gradient-light d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 text-primary">@quotation.QuotationNumber</h6>
                                        <span class="badge status-@quotation.Status.ToString().ToLower()">
                                            @quotation.Status
                                        </span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="customer-avatar me-2">
                                                @quotation.Customer.Name.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-medium">@quotation.Customer.Name</div>
                                                @if (!string.IsNullOrEmpty(quotation.Customer.CompanyName))
                                                {
                                                    <small class="text-muted">@quotation.Customer.CompanyName</small>
                                                }
                                            </div>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(quotation.ProjectName))
                                        {
                                            <p class="text-muted mb-2">
                                                <i class="fas fa-project-diagram me-1"></i>@quotation.ProjectName
                                            </p>
                                        }
                                        
                                        <div class="mb-2">
                                            <small class="text-muted">Date:</small>
                                            <div>@quotation.QuotationDate.ToString("MMM dd, yyyy")</div>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <small class="text-muted">Amount:</small>
                                            <div class="fw-bold text-success">₹@quotation.TotalAmount.ToString("N2")</div>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="btn-group w-100" role="group">
                                            <a href="@Url.Action("Details", new { id = quotation.Id })" 
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = quotation.Id })" 
                                               class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="@Url.Action("GeneratePdf", new { id = quotation.Id })" 
                                               class="btn btn-outline-info btn-sm">
                                                <i class="fas fa-file-pdf"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No quotations found</h5>
                    <p class="text-muted mb-3">Start by creating your first quotation</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create Quotation
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<script>
// Enhanced quotations functionality
document.addEventListener('DOMContentLoaded', function() {
    initializeQuotationsPage();
});

function initializeQuotationsPage() {
    // Initialize search functionality
    const searchInput = document.getElementById('quotationSearch');
    const statusFilter = document.getElementById('statusFilter');
    const customerFilter = document.getElementById('customerFilter');
    
    if (searchInput) {
        searchInput.addEventListener('input', filterQuotations);
    }
    if (statusFilter) {
        statusFilter.addEventListener('change', filterQuotations);
    }
    if (customerFilter) {
        customerFilter.addEventListener('change', filterQuotations);
    }
    
    // Initialize sorting
    initializeSorting();
}

function filterQuotations() {
    const searchTerm = document.getElementById('quotationSearch').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value;
    const customerFilter = document.getElementById('customerFilter').value;
    
    const rows = document.querySelectorAll('.quotation-row, .quotation-card');
    let visibleCount = 0;
    
    rows.forEach(row => {
        const searchText = row.getAttribute('data-search').toLowerCase();
        const status = row.getAttribute('data-status');
        const customer = row.getAttribute('data-customer');
        
        const matchesSearch = !searchTerm || searchText.includes(searchTerm);
        const matchesStatus = !statusFilter || status === statusFilter;
        const matchesCustomer = !customerFilter || customer === customerFilter;
        
        if (matchesSearch && matchesStatus && matchesCustomer) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });
    
    // Update count
    const countElement = document.getElementById('quotationCount');
    if (countElement) {
        countElement.textContent = visibleCount;
    }
}

function clearFilters() {
    document.getElementById('quotationSearch').value = '';
    document.getElementById('statusFilter').value = '';
    document.getElementById('customerFilter').value = '';
    filterQuotations();
}

function toggleView(viewType) {
    const tableView = document.getElementById('tableView');
    const gridView = document.getElementById('gridView');
    const buttons = document.querySelectorAll('.btn-group button');
    
    buttons.forEach(btn => btn.classList.remove('active'));
    
    if (viewType === 'table') {
        tableView.classList.remove('d-none');
        gridView.classList.add('d-none');
        buttons[0].classList.add('active');
    } else {
        tableView.classList.add('d-none');
        gridView.classList.remove('d-none');
        buttons[1].classList.add('active');
    }
}

function initializeSorting() {
    const sortableHeaders = document.querySelectorAll('.sortable');
    sortableHeaders.forEach(header => {
        header.addEventListener('click', function() {
            const sortBy = this.getAttribute('data-sort');
            sortTable(sortBy);
        });
    });
}

function sortTable(sortBy) {
    const table = document.getElementById('quotationsTable');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    
    rows.sort((a, b) => {
        let aVal, bVal;
        
        switch (sortBy) {
            case 'quotationNumber':
                aVal = a.cells[0].textContent.trim();
                bVal = b.cells[0].textContent.trim();
                break;
            case 'customer':
                aVal = a.cells[1].textContent.trim();
                bVal = b.cells[1].textContent.trim();
                break;
            case 'date':
                aVal = new Date(a.cells[2].textContent.trim());
                bVal = new Date(b.cells[2].textContent.trim());
                break;
            case 'amount':
                aVal = parseFloat(a.cells[3].textContent.replace(/[₹,]/g, ''));
                bVal = parseFloat(b.cells[3].textContent.replace(/[₹,]/g, ''));
                break;
            case 'status':
                aVal = a.cells[4].textContent.trim();
                bVal = b.cells[4].textContent.trim();
                break;
            default:
                return 0;
        }
        
        if (aVal < bVal) return -1;
        if (aVal > bVal) return 1;
        return 0;
    });
    
    // Clear and re-append sorted rows
    tbody.innerHTML = '';
    rows.forEach(row => tbody.appendChild(row));
}

function deleteQuotation(id) {
    if (InvGen.confirmDelete('Are you sure you want to delete this quotation?')) {
        // Implement delete functionality
        fetch(`/Quotations/Delete/${id}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                InvGen.showNotification('Error deleting quotation', 'danger');
            }
        })
        .catch(error => {
            InvGen.showNotification('Error deleting quotation', 'danger');
        });
    }
}
</script>
