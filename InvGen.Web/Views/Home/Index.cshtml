@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-5 fw-bold text-gradient mb-2">
                    <i class="fas fa-tachometer-alt me-3"></i>Dashboard
                </h1>
                <p class="lead text-muted mb-0">Welcome to InvGen Professional Quotation Generator</p>
                <small class="text-muted">
                    <i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </small>
            </div>
            <div class="d-none d-md-block">
                <div class="quick-actions">
                    <a href="@Url.Action("Create", "Quotations")" class="quick-action-btn text-decoration-none">
                        <div class="quick-action-icon">
                            <i class="fas fa-plus"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">New Quotation</div>
                            <small class="text-muted">Create estimate</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Key Metrics Cards -->
<div class="row mb-4 dashboard-stats">
    <!-- Revenue Metrics -->
    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
        <div class="card stat-card bg-gradient-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">₹@Model.TotalRevenue.ToString("N0")</h4>
                        <p class="mb-0 opacity-90">Total Revenue</p>
                        <small class="opacity-75">@Model.ApprovedQuotations approved</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-rupee-sign fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Index", "Quotations", new { status = QuotationStatus.Approved })" class="text-white text-decoration-none">
                    <small>View Approved <i class="fas fa-arrow-right ms-1"></i></small>
                </a>
            </div>
        </div>
    </div>

    <!-- Pending Revenue -->
    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
        <div class="card stat-card bg-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">₹@Model.PendingRevenue.ToString("N0")</h4>
                        <p class="mb-0 opacity-90">Pending Revenue</p>
                        <small class="opacity-75">@Model.SentQuotations sent</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-clock fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Index", "Quotations", new { status = QuotationStatus.Sent })" class="text-white text-decoration-none">
                    <small>View Sent <i class="fas fa-arrow-right ms-1"></i></small>
                </a>
            </div>
        </div>
    </div>

    <!-- This Month -->
    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
        <div class="card stat-card bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">₹@Model.ThisMonthRevenue.ToString("N0")</h4>
                        <p class="mb-0 opacity-90">This Month</p>
                        <small class="opacity-75">@Model.ThisMonthQuotations quotations</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-calendar-check fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Index", "Quotations")" class="text-white text-decoration-none">
                    <small>View All <i class="fas fa-arrow-right ms-1"></i></small>
                </a>
            </div>
        </div>
    </div>

    <!-- Conversion Rate -->
    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
        <div class="card stat-card bg-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">@Model.ConversionRate.ToString("F1")%</h4>
                        <p class="mb-0 opacity-90">Conversion Rate</p>
                        <small class="opacity-75">@Model.TotalQuotations total</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-chart-line fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="@Url.Action("Index", "Quotations")" class="text-white text-decoration-none">
                    <small>View Reports <i class="fas fa-arrow-right ms-1"></i></small>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Metrics -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card h-100 shadow-soft">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="fas fa-users fa-2x text-primary"></i>
                </div>
                <h5 class="card-title">@Model.TotalCustomers</h5>
                <p class="card-text text-muted">Active Customers</p>
                <a href="@Url.Action("Index", "Customers")" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-eye me-1"></i>View All
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card h-100 shadow-soft">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="fas fa-toolbox fa-2x text-success"></i>
                </div>
                <h5 class="card-title">@Model.TotalProducts</h5>
                <p class="card-text text-muted">Total Products</p>
                <a href="@Url.Action("Index", "Products")" class="btn btn-outline-success btn-sm">
                    <i class="fas fa-eye me-1"></i>View All
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card h-100 shadow-soft">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="fas fa-wrench fa-2x text-info"></i>
                </div>
                <h5 class="card-title">@Model.PlumbingProducts</h5>
                <p class="card-text text-muted">Plumbing Items</p>
                <a href="@Url.Action("Index", "Products", new { serviceType = "Plumbing" })" class="btn btn-outline-info btn-sm">
                    <i class="fas fa-eye me-1"></i>View All
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card h-100 shadow-soft">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="fas fa-bolt fa-2x text-warning"></i>
                </div>
                <h5 class="card-title">@Model.ElectricalProducts</h5>
                <p class="card-text text-muted">Electrical Items</p>
                <a href="@Url.Action("Index", "Products", new { serviceType = "Electrical" })" class="btn btn-outline-warning btn-sm">
                    <i class="fas fa-eye me-1"></i>View All
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Row -->
<div class="row">
    <!-- Recent Quotations -->
    <div class="col-xl-8 col-lg-7 mb-4">
        <div class="data-table-wrapper">
            <div class="data-table-header">
                <h5 class="data-table-title">
                    <i class="fas fa-file-invoice me-2"></i>Recent Quotations
                </h5>
                <div class="data-table-actions">
                    <a href="@Url.Action("Create", "Quotations")" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-1"></i>New Quotation
                    </a>
                    <a href="@Url.Action("Index", "Quotations")" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-list me-1"></i>View All
                    </a>
                </div>
            </div>

            @if (Model.RecentQuotations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="border-0">Quotation #</th>
                                <th class="border-0">Customer</th>
                                <th class="border-0">Date</th>
                                <th class="border-0">Amount</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var quotation in Model.RecentQuotations)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", "Quotations", new { id = quotation.Id })"
                                           class="text-decoration-none fw-semibold">
                                            @quotation.QuotationNumber
                                        </a>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="customer-avatar me-2" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                @quotation.Customer.Name.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-medium">@quotation.Customer.Name</div>
                                                @if (!string.IsNullOrEmpty(quotation.Customer.CompanyName))
                                                {
                                                    <small class="text-muted">@quotation.Customer.CompanyName</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>@quotation.QuotationDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@quotation.QuotationDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">₹@quotation.TotalAmount.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <span class="badge status-@quotation.Status.ToString().ToLower()">
                                            @quotation.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="@Url.Action("Details", "Quotations", new { id = quotation.Id })"
                                               class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "Quotations", new { id = quotation.Id })"
                                               class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-file-invoice fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No quotations yet</h5>
                    <p class="text-muted mb-3">Start by creating your first quotation</p>
                    <a href="@Url.Action("Create", "Quotations")" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Create First Quotation
                    </a>
                </div>
            }
        </div>
    </div>
    <!-- Sidebar -->
    <div class="col-xl-4 col-lg-5">
        <!-- Quick Actions -->
        <div class="card shadow-soft mb-4">
            <div class="card-header bg-gradient-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-bolt me-2 text-primary"></i>Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-3">
                    <a href="@Url.Action("Create", "Quotations")" class="quick-action-btn">
                        <div class="quick-action-icon">
                            <i class="fas fa-file-invoice"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">New Quotation</div>
                            <small class="text-muted">Create professional estimate</small>
                        </div>
                    </a>
                    <a href="@Url.Action("Create", "Customers")" class="quick-action-btn">
                        <div class="quick-action-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Add Customer</div>
                            <small class="text-muted">Register new client</small>
                        </div>
                    </a>
                    <a href="@Url.Action("Create", "Products")" class="quick-action-btn">
                        <div class="quick-action-icon">
                            <i class="fas fa-plus-circle"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Add Product</div>
                            <small class="text-muted">Expand your catalog</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Status Overview -->
        <div class="card shadow-soft mb-4">
            <div class="card-header bg-gradient-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-pie me-2 text-primary"></i>Quotation Status Overview
                </h5>
            </div>
            <div class="card-body">
                @{
                    var totalQuotations = Math.Max(1, Model.DraftQuotations + Model.SentQuotations + Model.ApprovedQuotations + Model.RejectedQuotations);
                }

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-medium">
                            <i class="fas fa-edit me-1 text-secondary"></i>Draft
                        </span>
                        <span class="badge bg-secondary">@Model.DraftQuotations</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-secondary" style="width: @(Model.DraftQuotations * 100 / totalQuotations)%"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-medium">
                            <i class="fas fa-paper-plane me-1 text-primary"></i>Sent
                        </span>
                        <span class="badge bg-primary">@Model.SentQuotations</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" style="width: @(Model.SentQuotations * 100 / totalQuotations)%"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-medium">
                            <i class="fas fa-check me-1 text-success"></i>Approved
                        </span>
                        <span class="badge bg-success">@Model.ApprovedQuotations</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: @(Model.ApprovedQuotations * 100 / totalQuotations)%"></div>
                    </div>
                </div>

                <div class="mb-0">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-medium">
                            <i class="fas fa-times me-1 text-danger"></i>Rejected
                        </span>
                        <span class="badge bg-danger">@Model.RejectedQuotations</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-danger" style="width: @(Model.RejectedQuotations * 100 / totalQuotations)%"></div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="fw-bold text-primary">@Model.ConversionRate.ToString("F1")%</div>
                        <small class="text-muted">Conversion Rate</small>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold text-info">@Model.TotalQuotations</div>
                        <small class="text-muted">Total Quotations</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="card shadow-soft">
            <div class="card-header bg-gradient-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-clock me-2 text-primary"></i>Recent Activity
                </h5>
            </div>
            <div class="card-body">
                @if (Model.RecentQuotations.Any())
                {
                    @foreach (var quotation in Model.RecentQuotations.Take(5))
                    {
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <div class="customer-avatar me-3" style="width: 40px; height: 40px;">
                                    @quotation.Customer.Name.Substring(0, 1).ToUpper()
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-medium">@quotation.QuotationNumber</div>
                                <small class="text-muted">@quotation.Customer.Name</small>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">@quotation.QuotationDate.ToString("MMM dd, yyyy")</small>
                                    <span class="badge status-@quotation.Status.ToString().ToLower() badge-sm">
                                        @quotation.Status
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fas fa-clock fa-2x text-muted mb-2"></i>
                        <p class="text-muted mb-0">No recent activity</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
