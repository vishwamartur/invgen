@model Customer
@{
    ViewData["Title"] = "Customer Details";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-6 fw-bold text-gradient mb-2">
                    <i class="fas fa-user me-3"></i>Customer Details
                </h1>
                <p class="lead text-muted mb-0">
                    <strong>@Model.Name</strong>
                    @if (!string.IsNullOrEmpty(Model.CompanyName))
                    {
                        <span class="text-muted">• @Model.CompanyName</span>
                    }
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") ms-2">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </p>
            </div>
            <div class="d-none d-md-block">
                <div class="btn-group">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-primary">
                        <i class="fas fa-edit me-2"></i>Edit
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Customer Information -->
<div class="row mb-4">
    <!-- Basic Information -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-soft h-100">
            <div class="card-header bg-gradient-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-user me-2"></i>Basic Information
                </h5>
            </div>
            <div class="card-body">
                <div class="customer-info">
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">Full Name:</label>
                        <p class="mb-0">@Model.Name</p>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.CompanyName))
                    {
                        <div class="info-item mb-3">
                            <label class="fw-bold text-muted">Company:</label>
                            <p class="mb-0">@Model.CompanyName</p>
                        </div>
                    }
                    
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">Email:</label>
                        <p class="mb-0">
                            <a href="mailto:@Model.Email" class="text-decoration-none">
                                <i class="fas fa-envelope me-1"></i>@Model.Email
                            </a>
                        </p>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <div class="info-item mb-3">
                            <label class="fw-bold text-muted">Phone:</label>
                            <p class="mb-0">
                                <a href="tel:@Model.Phone" class="text-decoration-none">
                                    <i class="fas fa-phone me-1"></i>@Model.Phone
                                </a>
                            </p>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(Model.Mobile))
                    {
                        <div class="info-item mb-3">
                            <label class="fw-bold text-muted">Mobile:</label>
                            <p class="mb-0">
                                <a href="tel:@Model.Mobile" class="text-decoration-none">
                                    <i class="fas fa-mobile-alt me-1"></i>@Model.Mobile
                                </a>
                            </p>
                        </div>
                    }
                    
                    <div class="info-item mb-0">
                        <label class="fw-bold text-muted">Status:</label>
                        <p class="mb-0">
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Address Information -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-soft h-100">
            <div class="card-header bg-gradient-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-map-marker-alt me-2"></i>Address Information
                </h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Address) || !string.IsNullOrEmpty(Model.City))
                {
                    <div class="address-info">
                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="info-item mb-3">
                                <label class="fw-bold text-muted">Address:</label>
                                <p class="mb-0">@Model.Address</p>
                            </div>
                        }
                        
                        <div class="row">
                            @if (!string.IsNullOrEmpty(Model.City))
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="fw-bold text-muted">City:</label>
                                    <p class="mb-0">@Model.City</p>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.State))
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="fw-bold text-muted">State:</label>
                                    <p class="mb-0">@Model.State</p>
                                </div>
                            }
                        </div>
                        
                        <div class="row">
                            @if (!string.IsNullOrEmpty(Model.PostalCode))
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="fw-bold text-muted">Postal Code:</label>
                                    <p class="mb-0">@Model.PostalCode</p>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.Country))
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="fw-bold text-muted">Country:</label>
                                    <p class="mb-0">@Model.Country</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-map-marker-alt fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No address information</h6>
                        <p class="text-muted mb-0">Address details have not been provided for this customer.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Business Information & Activity -->
<div class="row mb-4">
    <!-- Business Information -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-soft">
            <div class="card-header bg-gradient-success text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-briefcase me-2"></i>Business Information
                </h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.GstNumber))
                {
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">GST Number:</label>
                        <p class="mb-0 font-monospace">@Model.GstNumber</p>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No GST information</h6>
                        <p class="text-muted mb-0">GST number has not been provided for this customer.</p>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <!-- Activity Information -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-soft">
            <div class="card-header bg-gradient-warning text-dark">
                <h5 class="card-title mb-0">
                    <i class="fas fa-clock me-2"></i>Activity Information
                </h5>
            </div>
            <div class="card-body">
                <div class="info-item mb-3">
                    <label class="fw-bold text-muted">Created:</label>
                    <p class="mb-0">@Model.CreatedDate.ToString("MMM dd, yyyy 'at' HH:mm")</p>
                </div>
                
                @if (Model.UpdatedDate.HasValue)
                {
                    <div class="info-item mb-0">
                        <label class="fw-bold text-muted">Last Updated:</label>
                        <p class="mb-0">@Model.UpdatedDate.Value.ToString("MMM dd, yyyy 'at' HH:mm")</p>
                    </div>
                }
                else
                {
                    <div class="info-item mb-0">
                        <label class="fw-bold text-muted">Last Updated:</label>
                        <p class="mb-0 text-muted">Never updated</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Related Quotations -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-soft">
            <div class="card-header bg-gradient-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-invoice me-2"></i>Related Quotations
                    </h5>
                    <a href="@Url.Action("Create", "Quotations", new { customerId = Model.Id })" class="btn btn-light btn-sm">
                        <i class="fas fa-plus me-1"></i>New Quotation
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Quotations?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Quotation #</th>
                                    <th>Project</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var quotation in Model.Quotations.OrderByDescending(q => q.CreatedDate))
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Details", "Quotations", new { id = quotation.Id })" class="text-decoration-none">
                                                @quotation.QuotationNumber
                                            </a>
                                        </td>
                                        <td>@quotation.ProjectName</td>
                                        <td>@quotation.QuotationDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge status-@quotation.Status.ToString().ToLower()">
                                                @quotation.Status
                                            </span>
                                        </td>
                                        <td class="fw-bold">₹@quotation.TotalAmount.ToString("N2")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="@Url.Action("Details", "Quotations", new { id = quotation.Id })" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="@Url.Action("Edit", "Quotations", new { id = quotation.Id })" class="btn btn-outline-secondary btn-sm">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No quotations yet</h5>
                        <p class="text-muted mb-3">This customer doesn't have any quotations yet.</p>
                        <a href="@Url.Action("Create", "Quotations", new { customerId = Model.Id })" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Create First Quotation
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
/* Customer Details specific styles */
.customer-info .info-item,
.address-info .info-item {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
}

.customer-info .info-item:last-child,
.address-info .info-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.customer-info label,
.address-info label {
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
    display: block;
}

.customer-info p,
.address-info p {
    font-size: 1rem;
    color: var(--dark-color);
}

.btn-group .btn {
    min-width: 80px;
}

@@media (max-width: 768px) {
    .btn-group {
        flex-direction: column;
        width: 100%;
    }
    
    .btn-group .btn {
        margin-bottom: 0.5rem;
    }
    
    .table-responsive {
        font-size: 0.875rem;
    }
}
</style>
