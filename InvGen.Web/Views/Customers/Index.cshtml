@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-users me-2 text-primary"></i>Customers
            </h2>
            <p class="text-muted mb-0">Manage your customer database</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Customer
            </a>
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-download me-2"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" onclick="exportCustomers('csv')">Export as CSV</a></li>
                    <li><a class="dropdown-item" href="#" onclick="exportCustomers('excel')">Export as Excel</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card shadow-soft mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" class="form-control search-input" placeholder="Search customers..."
                               data-search-type="customers" id="customerSearch" value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="cityFilter">
                        <option value="">All Cities</option>
                        @foreach (var city in ViewBag.Cities as IEnumerable<string> ?? Enumerable.Empty<string>())
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="sortBy">
                        <option value="name">Sort by Name</option>
                        <option value="company">Sort by Company</option>
                        <option value="city">Sort by City</option>
                        <option value="quotations">Sort by Quotations</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Customers Table -->
    <div class="card shadow-soft">
        <div class="card-header bg-gradient-light">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-list me-2"></i>Customer Directory
                </h5>
                <div class="d-flex align-items-center gap-3">
                    <small class="text-muted">
                        <span id="customerCount">@Model.Count()</span> customers found
                    </small>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary active" onclick="toggleView('table')">
                            <i class="fas fa-table"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <!-- Table View (Default) -->
                <div id="tableView">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="customersTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="sortable" data-sort="name">
                                        <i class="fas fa-sort me-1"></i>Customer
                                    </th>
                                    <th class="sortable" data-sort="company">
                                        <i class="fas fa-sort me-1"></i>Company
                                    </th>
                                    <th class="sortable" data-sort="email">
                                        <i class="fas fa-sort me-1"></i>Contact
                                    </th>
                                    <th class="sortable" data-sort="city">
                                        <i class="fas fa-sort me-1"></i>Location
                                    </th>
                                    <th class="sortable" data-sort="quotations">
                                        <i class="fas fa-sort me-1"></i>Quotations
                                    </th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Model)
                                {
                                    <tr class="customer-row"
                                        data-city="@customer.City"
                                        data-search="@customer.Name @customer.CompanyName @customer.Email @customer.Phone @customer.City">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="customer-avatar me-3">
                                                    @customer.Name.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <div class="fw-medium">@customer.Name</div>
                                                    <small class="text-muted">Customer since @customer.CreatedDate.ToString("MMM yyyy")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(customer.CompanyName))
                                            {
                                                <div class="fw-medium">@customer.CompanyName</div>
                                                @if (!string.IsNullOrEmpty(customer.GstNumber))
                                                {
                                                    <small class="text-muted">GST: @customer.GstNumber</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Individual</span>
                                            }
                                        </td>
                                        <td>
                                            <div>
                                                <a href="mailto:@customer.Email" class="text-decoration-none">
                                                    <i class="fas fa-envelope me-1"></i>@customer.Email
                                                </a>
                                            </div>
                                            @if (!string.IsNullOrEmpty(customer.Phone))
                                            {
                                                <div class="mt-1">
                                                    <a href="tel:@customer.Phone" class="text-decoration-none">
                                                        <i class="fas fa-phone me-1"></i>@customer.Phone
                                                    </a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(customer.Mobile))
                                            {
                                                <div class="mt-1">
                                                    <a href="tel:@customer.Mobile" class="text-decoration-none">
                                                        <i class="fas fa-mobile-alt me-1"></i>@customer.Mobile
                                                    </a>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(customer.City))
                                            {
                                                <div>
                                                    <i class="fas fa-map-marker-alt me-1"></i>@customer.City
                                                    @if (!string.IsNullOrEmpty(customer.State))
                                                    {
                                                        <span>, @customer.State</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(customer.PostalCode))
                                                {
                                                    <small class="text-muted">@customer.PostalCode</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-primary me-2">@customer.Quotations.Count</span>
                                                @if (customer.Quotations.Any())
                                                {
                                                    var totalValue = customer.Quotations.Sum(q => q.TotalAmount);
                                                    <small class="text-muted">₹@totalValue.ToString("N0")</small>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Details" asp-route-id="@customer.Id"
                                                   class="btn btn-outline-primary"
                                                   data-bs-toggle="tooltip"
                                                   title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@customer.Id"
                                                   class="btn btn-outline-secondary"
                                                   data-bs-toggle="tooltip"
                                                   title="Edit Customer">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-controller="Quotations" asp-action="Create" asp-route-customerId="@customer.Id"
                                                   class="btn btn-outline-success"
                                                   data-bs-toggle="tooltip"
                                                   title="New Quotation">
                                                    <i class="fas fa-file-invoice"></i>
                                                </a>
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        onclick="deleteCustomer(@customer.Id)"
                                                        data-bs-toggle="tooltip"
                                                        title="Delete Customer">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Grid View (Hidden by default) -->
                <div id="gridView" class="d-none p-3">
                    <div class="row g-3">
                        @foreach (var customer in Model)
                        {
                            <div class="col-xl-3 col-lg-4 col-md-6 customer-card"
                                 data-city="@customer.City"
                                 data-search="@customer.Name @customer.CompanyName @customer.Email @customer.Phone @customer.City">
                                <div class="card h-100 shadow-soft">
                                    <div class="card-header bg-gradient-light d-flex justify-content-between align-items-center">
                                        <div class="customer-avatar">
                                            @customer.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="badge bg-primary">@customer.Quotations.Count quotations</span>
                                    </div>
                                    <div class="card-body">
                                        <h6 class="card-title text-primary mb-2">@customer.Name</h6>

                                        @if (!string.IsNullOrEmpty(customer.CompanyName))
                                        {
                                            <p class="text-muted mb-2">
                                                <i class="fas fa-building me-1"></i>@customer.CompanyName
                                            </p>
                                        }

                                        <div class="mb-2">
                                            <a href="mailto:@customer.Email" class="text-decoration-none">
                                                <i class="fas fa-envelope me-1"></i>@customer.Email
                                            </a>
                                        </div>

                                        @if (!string.IsNullOrEmpty(customer.Phone))
                                        {
                                            <div class="mb-2">
                                                <a href="tel:@customer.Phone" class="text-decoration-none">
                                                    <i class="fas fa-phone me-1"></i>@customer.Phone
                                                </a>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(customer.City))
                                        {
                                            <div class="mb-2">
                                                <i class="fas fa-map-marker-alt me-1"></i>@customer.City
                                                @if (!string.IsNullOrEmpty(customer.State))
                                                {
                                                    <span>, @customer.State</span>
                                                }
                                            </div>
                                        }

                                        @if (customer.Quotations.Any())
                                        {
                                            var totalValue = customer.Quotations.Sum(q => q.TotalAmount);
                                            <div class="mb-2">
                                                <small class="text-muted">Total Business:</small>
                                                <div class="fw-bold text-success">₹@totalValue.ToString("N2")</div>
                                            </div>
                                        }
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="btn-group w-100" role="group">
                                            <a asp-action="Details" asp-route-id="@customer.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@customer.Id"
                                               class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-controller="Quotations" asp-action="Create" asp-route-customerId="@customer.Id"
                                               class="btn btn-outline-success btn-sm">
                                                <i class="fas fa-file-invoice"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No customers found</h5>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                    {
                        <p class="text-muted mb-3">
                            No customers match your search criteria.
                            <a asp-action="Index" class="text-decoration-none">View all customers</a>
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-3">Get started by adding your first customer</p>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Add Customer
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
// Enhanced customers functionality
document.addEventListener('DOMContentLoaded', function() {
    initializeCustomersPage();
});

function initializeCustomersPage() {
    // Initialize search functionality
    const searchInput = document.getElementById('customerSearch');
    const cityFilter = document.getElementById('cityFilter');
    const sortBy = document.getElementById('sortBy');

    if (searchInput) {
        searchInput.addEventListener('input', filterCustomers);
    }
    if (cityFilter) {
        cityFilter.addEventListener('change', filterCustomers);
    }
    if (sortBy) {
        sortBy.addEventListener('change', sortCustomers);
    }

    // Initialize sorting
    initializeSorting();
}

function filterCustomers() {
    const searchTerm = document.getElementById('customerSearch').value.toLowerCase();
    const cityFilter = document.getElementById('cityFilter').value;

    const items = document.querySelectorAll('.customer-row, .customer-card');
    let visibleCount = 0;

    items.forEach(item => {
        const searchText = item.getAttribute('data-search').toLowerCase();
        const city = item.getAttribute('data-city');

        const matchesSearch = !searchTerm || searchText.includes(searchTerm);
        const matchesCity = !cityFilter || city === cityFilter;

        if (matchesSearch && matchesCity) {
            item.style.display = '';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });

    // Update count
    const countElement = document.getElementById('customerCount');
    if (countElement) {
        countElement.textContent = visibleCount;
    }
}

function clearFilters() {
    document.getElementById('customerSearch').value = '';
    document.getElementById('cityFilter').value = '';
    document.getElementById('sortBy').value = 'name';
    filterCustomers();
}

function toggleView(viewType) {
    const tableView = document.getElementById('tableView');
    const gridView = document.getElementById('gridView');
    const buttons = document.querySelectorAll('.btn-group button');

    buttons.forEach(btn => btn.classList.remove('active'));

    if (viewType === 'table') {
        tableView.classList.remove('d-none');
        gridView.classList.add('d-none');
        buttons[0].classList.add('active');
    } else {
        tableView.classList.add('d-none');
        gridView.classList.remove('d-none');
        buttons[1].classList.add('active');
    }
}

function initializeSorting() {
    const sortableHeaders = document.querySelectorAll('.sortable');
    sortableHeaders.forEach(header => {
        header.addEventListener('click', function() {
            const sortBy = this.getAttribute('data-sort');
            sortTable(sortBy);
        });
    });
}

function sortTable(sortBy) {
    const table = document.getElementById('customersTable');
    if (!table) return;

    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));

    rows.sort((a, b) => {
        let aVal, bVal;

        switch (sortBy) {
            case 'name':
                aVal = a.cells[0].textContent.trim();
                bVal = b.cells[0].textContent.trim();
                break;
            case 'company':
                aVal = a.cells[1].textContent.trim();
                bVal = b.cells[1].textContent.trim();
                break;
            case 'email':
                aVal = a.cells[2].textContent.trim();
                bVal = b.cells[2].textContent.trim();
                break;
            case 'city':
                aVal = a.cells[3].textContent.trim();
                bVal = b.cells[3].textContent.trim();
                break;
            case 'quotations':
                aVal = parseInt(a.cells[4].textContent.trim());
                bVal = parseInt(b.cells[4].textContent.trim());
                break;
            default:
                return 0;
        }

        if (aVal < bVal) return -1;
        if (aVal > bVal) return 1;
        return 0;
    });

    // Clear and re-append sorted rows
    tbody.innerHTML = '';
    rows.forEach(row => tbody.appendChild(row));
}

function sortCustomers() {
    const sortBy = document.getElementById('sortBy').value;
    sortTable(sortBy);
}

function deleteCustomer(id) {
    if (InvGen.confirmDelete('Are you sure you want to delete this customer? This will also delete all associated quotations.')) {
        fetch(`/Customers/Delete/${id}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                InvGen.showNotification('Error deleting customer', 'danger');
            }
        })
        .catch(error => {
            InvGen.showNotification('Error deleting customer', 'danger');
        });
    }
}

function exportCustomers(format) {
    InvGen.showNotification(`Exporting customers as ${format.toUpperCase()}...`, 'info');
    // Implement export functionality
}
</script>
